# Juvantia Auth - Environment Variables Template

# ZeroDev (Smart Accounts)
NEXT_PUBLIC_PROJECT_ID=your_zerodev_project_id

# SuperTokens (SSO)
NEXT_PUBLIC_API_DOMAIN=https://auth.juvantia.org
NEXT_PUBLIC_WEBSITE_DOMAIN=https://auth.juvantia.org
SUPERTOKENS_CONNECTION_URI=http://localhost:3567
SUPERTOKENS_API_KEY=your_supertokens_key

# Database
POSTGRES_URI=postgresql://user:password@host:5432/database

# SMTP (Email Delivery)
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=noreply@example.com
SMTP_PASS=your_password
SMTP_FROM_NAME="Juvantia Auth"
SMTP_FROM_EMAIL="noreply@example.com"
